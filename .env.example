# Optional: forward every waitlist signup to an external endpoint (CRM / email tool webhook).
# Receives a JSON POST: { "email": "...", "consent": true, "source": "sydney-landing", "submittedAt": "ISO-8601" }
WAITLIST_WEBHOOK_URL=

# Where the local JSONL fallback store writes signups (defaults to .data/waitlist.jsonl)
WAITLIST_STORE_FILE=
