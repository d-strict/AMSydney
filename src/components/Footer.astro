---
import { site } from '../data/site';
---

<footer class="footer">
  <div class="container footer-inner">
    <p class="footer-copy">{site.footer.copyright}</p>
    <nav class="footer-links" aria-label="Footer">
      <a href="#" data-open-privacy>Privacy Collection Notice</a>
      <span aria-hidden="true">·</span>
      <a href={site.links.privacyPolicy} target="_blank" rel="noopener noreferrer">Privacy Policy</a>
      <span aria-hidden="true">·</span>
      <a href={site.links.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    background: var(--black);
    border-top: 1px solid var(--grey-700);
    padding-block: 1.6rem;
    font-size: 0.78rem;
    color: var(--grey-500);
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .footer-copy {
    margin: 0;
  }
  .footer-links {
    display: flex;
    gap: 0.55rem;
    align-items: center;
  }
  .footer-links a {
    color: var(--grey-500);
    text-decoration: none;
  }
  .footer-links a:hover {
    color: var(--grey-300);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
